<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Resonance.WinUI.Dialogs.ArtworkLightBoxDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:Resonance.WinUI.ViewModels"
    mc:Ignorable="d"
    Title="Capa do Álbum"
    PrimaryButtonText="Exportar Imagem"
    CloseButtonText="Fechar"
    DefaultButton="Close"
    PrimaryButtonClick="OnExportButtonClick"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">480</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">640</x:Double>
    </ContentDialog.Resources>

    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16" Margin="0,12,0,0">
        <!-- Subtitle Info -->
        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="{x:Bind ViewModel.CurrentData.Tags.Title, Mode=OneWay}"
                       FontWeight="SemiBold"
                       FontSize="15"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{x:Bind ViewModel.CurrentData.Tags.ArtistsFormatted, Mode=OneWay}"
                       FontSize="13"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!-- Large Image -->
        <Border Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="8">
            <Image Source="{x:Bind ViewModel.CurrentData.Artwork.CoverArtUri, Mode=OneWay, Converter={StaticResource StringToDecodedImageSourceConverter}, ConverterParameter=800}"
                   MaxWidth="500"
                   MaxHeight="500"
                   Stretch="Uniform" />
        </Border>

        <!-- Technical Metadata of Artwork -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Padding="4,0">
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="{x:Bind ViewModel.CurrentData.Artwork.DimensionsSummary, Mode=OneWay}"
                           FontSize="12"
                           FontWeight="Medium" />
                <TextBlock Text="{x:Bind ViewModel.CurrentData.Artwork.MimeType, Mode=OneWay}"
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Border Grid.Column="1"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="4"
                    Padding="8,4"
                    VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.CurrentData.Artwork.SourceSummary, Mode=OneWay}"
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Border>
        </Grid>
    </Grid>
</ContentDialog>
