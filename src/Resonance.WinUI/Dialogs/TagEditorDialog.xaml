<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Resonance.WinUI.Dialogs.TagEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Resonance.Core.Models"
    xmlns:viewmodels="using:Resonance.WinUI.ViewModels"
    mc:Ignorable="d"
    Title="Editor de Metadados &amp; Tags"
    PrimaryButtonText="Gravar Alterações"
    CloseButtonText="Cancelar"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick"
    CloseButtonClick="OnCloseButtonClick"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">740</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">920</x:Double>
    </ContentDialog.Resources>

    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14" Margin="0,8,0,0">

        <!-- Top Header & Mode Toggle -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="{x:Bind ViewModel.FilePath, Mode=OneWay}"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="500" />
                <TextBlock Text="{x:Bind GetSubheaderText(ViewModel.IsReviewMode, ViewModel.SelectedCount, ViewModel.TotalDiffCount), Mode=OneWay}"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </StackPanel>

            <Border Grid.Column="1"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="6"
                    Padding="3">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button Content="Revisão de Sugestões"
                            Click="OnReviewModeClick"
                            Background="{x:Bind GetReviewButtonBackground(ViewModel.IsReviewMode), Mode=OneWay}"
                            Padding="10,4"
                            CornerRadius="4"
                            FontSize="12" />
                    <Button Content="Edição Manual"
                            Click="OnManualModeClick"
                            Background="{x:Bind GetManualButtonBackground(ViewModel.IsReviewMode), Mode=OneWay}"
                            Padding="10,4"
                            CornerRadius="4"
                            FontSize="12" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main Body: ScrollViewer containing either Diff Review or Manual Form + Cover Art -->
        <ScrollViewer Grid.Row="1"
                      MaxHeight="500"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16">

                <!-- 1. MODE: DIFF REVIEW -->
                <StackPanel Spacing="10"
                            Visibility="{x:Bind ViewModel.IsReviewMode, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <!-- Select All Bar -->
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          BorderThickness="1"
                          CornerRadius="6"
                          Padding="12,8">
                        <CheckBox Grid.Column="0"
                                  Content="Selecionar todas as alterações"
                                  IsChecked="{x:Bind GetAreAllSelected(ViewModel.SelectedCount, ViewModel.TotalDiffCount), Mode=OneWay}"
                                  Command="{x:Bind ViewModel.ToggleSelectAllCommand}"
                                  FontWeight="SemiBold" />

                        <TextBlock Grid.Column="2"
                                   Text="{x:Bind GetCounterText(ViewModel.SelectedCount, ViewModel.TotalDiffCount), Mode=OneWay}"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>

                    <!-- Diff Items List -->
                    <ItemsControl ItemsSource="{x:Bind ViewModel.DiffRecords, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:TagDiffRecord">
                                <Grid ColumnDefinitions="Auto,120,*,*,Auto"
                                      ColumnSpacing="12"
                                      Padding="8,8"
                                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                      BorderThickness="0,0,0,1">

                                    <!-- Selection Checkbox -->
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                              IsEnabled="{x:Bind HasChanged, Mode=OneWay}"
                                              VerticalAlignment="Center"
                                              Margin="0" />

                                    <!-- Field Name -->
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind DisplayName, Mode=OneWay}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />

                                    <!-- Current / Original Value -->
                                    <TextBlock Grid.Column="2"
                                               Text="{x:Bind OriginalValue, Mode=OneWay}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />

                                    <!-- Proposed Value -->
                                    <TextBlock Grid.Column="3"
                                               Text="{x:Bind ProposedValue, Mode=OneWay}"
                                               FontWeight="Medium"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />

                                    <!-- Status Badge -->
                                    <Border Grid.Column="4"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind StatusDisplay, Mode=OneWay}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- 2. MODE: MANUAL EDITING -->
                <Grid Visibility="{x:Bind ViewModel.IsReviewMode, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                      ColumnDefinitions="*,*"
                      RowSpacing="12"
                      ColumnSpacing="14">

                    <!-- Title (Span 2) -->
                    <TextBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                             Header="Título da Música"
                             Text="{x:Bind ViewModel.EditableTags.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- Artist & Album Artist -->
                    <TextBox Grid.Row="1" Grid.Column="0"
                             Header="Artista(s)"
                             Text="{x:Bind ViewModel.EditableTags.Artist, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBox Grid.Row="1" Grid.Column="1"
                             Header="Artista do Álbum"
                             Text="{x:Bind ViewModel.EditableTags.AlbumArtist, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- Album & Year -->
                    <TextBox Grid.Row="2" Grid.Column="0"
                             Header="Álbum"
                             Text="{x:Bind ViewModel.EditableTags.Album, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBox Grid.Row="2" Grid.Column="1"
                             Header="Ano"
                             Text="{x:Bind ViewModel.EditableTags.Year, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- Track / Total & Disc / Total -->
                    <Grid Grid.Row="3" Grid.Column="0" ColumnDefinitions="*,* " ColumnSpacing="8">
                        <TextBox Grid.Column="0"
                                 Header="Nº Faixa"
                                 Text="{x:Bind ViewModel.EditableTags.TrackNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Grid.Column="1"
                                 Header="Total Faixas"
                                 Text="{x:Bind ViewModel.EditableTags.TrackTotal, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,*" ColumnSpacing="8">
                        <TextBox Grid.Column="0"
                                 Header="Nº Disco"
                                 Text="{x:Bind ViewModel.EditableTags.DiscNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Grid.Column="1"
                                 Header="Total Discos"
                                 Text="{x:Bind ViewModel.EditableTags.DiscTotal, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <!-- Genre & Comment -->
                    <TextBox Grid.Row="4" Grid.Column="0"
                             Header="Gênero"
                             Text="{x:Bind ViewModel.EditableTags.Genre, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBox Grid.Row="4" Grid.Column="1"
                             Header="Comentário"
                             Text="{x:Bind ViewModel.EditableTags.Comment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <!-- 3. COVER ART MANAGEMENT CARD -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                        <!-- Current vs Proposed Artwork Thumbnails -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                <TextBlock Text="Capa Atual" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                <Border Width="90" Height="90" CornerRadius="6"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <Image Source="{x:Bind ViewModel.CurrentCoverUri, Mode=OneWay, Converter={StaticResource StringToDecodedImageSourceConverter}, ConverterParameter=180}"
                                           Stretch="UniformToFill" />
                                </Border>
                            </StackPanel>

                            <FontIcon Glyph="&#xE72A;"
                                      FontSize="16"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                      Visibility="{x:Bind ViewModel.HasProposedCover, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <StackPanel Spacing="4"
                                        HorizontalAlignment="Center"
                                        Visibility="{x:Bind ViewModel.HasProposedCover, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Nova Capa" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                                <Border Width="90" Height="90" CornerRadius="6"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                        BorderThickness="2">
                                    <Image Source="{x:Bind ViewModel.ProposedCoverUri, Mode=OneWay, Converter={StaticResource StringToDecodedImageSourceConverter}, ConverterParameter=180}"
                                           Stretch="UniformToFill" />
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Center Info & Options -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                            <TextBlock Text="Arte da Capa do Álbum" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="A capa será embutida diretamente como Picture block (Front Cover) no container de áudio."
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />

                            <CheckBox Content="Gravar esta capa no arquivo físico"
                                      IsChecked="{x:Bind ViewModel.IncludeCoverArt, Mode=TwoWay}"
                                      IsEnabled="{x:Bind ViewModel.HasProposedCover, Mode=OneWay}"
                                      FontSize="12"
                                      Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- Action Buttons -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="8">
                            <Button Command="{x:Bind ViewModel.PickCustomCoverCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xEB9F;" FontSize="14" />
                                    <TextBlock Text="Escolher Arquivo..." />
                                </StackPanel>
                            </Button>

                            <Button Command="{x:Bind ViewModel.RemoveCoverCommand}"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                    <TextBlock Text="Remover Capa" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Feedback & Progress -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="12"
              Visibility="{x:Bind GetStatusVisibility(ViewModel.StatusMessage, ViewModel.IsSaving), Mode=OneWay}">
            <ProgressRing Grid.Column="0"
                          IsActive="{x:Bind ViewModel.IsSaving, Mode=OneWay}"
                          Width="20" Height="20"
                          Visibility="{x:Bind ViewModel.IsSaving, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <TextBlock Grid.Column="1"
                       Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       FontSize="13"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{x:Bind GetStatusBrush(ViewModel.HasStatusError), Mode=OneWay}" />
        </Grid>
    </Grid>
</ContentDialog>
