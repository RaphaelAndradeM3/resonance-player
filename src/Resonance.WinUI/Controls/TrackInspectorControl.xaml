<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Resonance.WinUI.Controls.TrackInspectorControl"
    x:Name="InspectorRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Resonance.Core.Models"
    xmlns:viewmodels="using:Resonance.WinUI.ViewModels"
    mc:Ignorable="d"
    d:DesignWidth="360"
    d:DesignHeight="800">

    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
          BorderThickness="1,0,0,0">
        <Grid.Transitions>
            <TransitionCollection>
                <EntranceThemeTransition FromHorizontalOffset="120" IsStaggeringEnabled="False" />
                <RepositionThemeTransition />
            </TransitionCollection>
        </Grid.Transitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header: Title, Follow-Playback Toggle, and Close Button -->
        <Grid Grid.Row="0" Padding="16,14,12,12" Background="{ThemeResource LayerOnAcrylicFillColorDefault}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE946;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="Propriedades da Faixa"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>

            <ToggleButton Grid.Column="1"
                          IsChecked="{x:Bind ViewModel.FollowPlayback, Mode=TwoWay}"
                          ToolTipService.ToolTip="Seguir faixa em reprodução"
                          Margin="0,0,4,0"
                          Padding="6,4"
                          Background="Transparent"
                          BorderBrush="Transparent">
                <FontIcon Glyph="&#xE8D6;" FontSize="14" />
            </ToggleButton>

            <Button Grid.Column="2"
                    Command="{x:Bind ViewModel.CloseInspectorCommand}"
                    ToolTipService.ToolTip="Fechar painel (Esc)"
                    Padding="6,4"
                    Background="Transparent"
                    BorderBrush="Transparent">
                <FontIcon Glyph="&#xE711;" FontSize="14" />
            </Button>
        </Grid>

        <!-- Multi-Track Pagination Bar -->
        <Grid Grid.Row="1"
              Padding="16,6"
              Background="{ThemeResource SubtleFillColorSecondaryBrush}"
              Visibility="{x:Bind ViewModel.HasMultipleTracks, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Command="{x:Bind ViewModel.PreviousSelectedTrackCommand}"
                    IsEnabled="{x:Bind ViewModel.CurrentData.HasPreviousTrack, Mode=OneWay}"
                    Padding="8,4"
                    ToolTipService.ToolTip="Faixa anterior">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon Glyph="&#xE76B;" FontSize="11" />
                    <TextBlock Text="Anterior" FontSize="12" />
                </StackPanel>
            </Button>

            <TextBlock Grid.Column="1"
                       Text="{x:Bind ViewModel.PaginationText, Mode=OneWay}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="12"
                       FontWeight="Medium"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <Button Grid.Column="2"
                    Command="{x:Bind ViewModel.NextSelectedTrackCommand}"
                    IsEnabled="{x:Bind ViewModel.CurrentData.HasNextTrack, Mode=OneWay}"
                    Padding="8,4"
                    ToolTipService.ToolTip="Próxima faixa">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Próxima" FontSize="12" />
                    <FontIcon Glyph="&#xE76C;" FontSize="11" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Loading Progress Bar -->
        <ProgressBar Grid.Row="2"
                     IsIndeterminate="True"
                     Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <!-- Main Content Area -->
        <ScrollViewer Grid.Row="3"
                      Padding="16,12"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16">

                <!-- Inaccessible Warning Banner -->
                <Border Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                        BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Visibility="{x:Bind ViewModel.CurrentData.Technical.IsAccessible, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7BA;" Foreground="{ThemeResource SystemFillColorCautionBrush}" FontSize="16" />
                            <TextBlock Text="Arquivo Inacessível" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="O arquivo original não foi encontrado no disco. Os metadados exibidos abaixo foram recuperados da biblioteca local."
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Track Header & Thumbnail Summary -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Artwork Thumbnail with LightBox Trigger -->
                        <Button Grid.Column="0"
                                Padding="0"
                                Margin="0,0,12,0"
                                Width="72"
                                Height="72"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                CornerRadius="6"
                                Click="OnArtworkThumbnailClick"
                                ToolTipService.ToolTip="Clique para ver a capa em tamanho real">
                            <Grid CornerRadius="6">
                                <Image Source="{x:Bind ViewModel.CurrentData.Artwork.CoverArtUri, Mode=OneWay, Converter={StaticResource StringToDecodedImageSourceConverter}, ConverterParameter=200}"
                                       Stretch="UniformToFill"
                                       Width="72"
                                       Height="72" />
                                <Border Background="#40000000"
                                        Opacity="0"
                                        PointerEntered="OnThumbnailOverlayPointerEntered"
                                        PointerExited="OnThumbnailOverlayPointerExited"
                                        x:Name="ThumbnailOverlay">
                                    <FontIcon Glyph="&#xE721;" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Title and Artist Summary -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.CurrentData.Tags.Title, Mode=OneWay}"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       MaxLines="2"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind ViewModel.CurrentData.Tags.ArtistsFormatted, Mode=OneWay}"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind ViewModel.CurrentData.Tags.Album, Mode=OneWay}"
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Technical Details Card (User Story 1 - MVP) -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE946;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Propriedades Técnicas de Áudio"
                                       FontWeight="SemiBold"
                                       FontSize="13" />
                        </StackPanel>

                        <MenuFlyoutSeparator Margin="-14,0,-14,0" />

                        <!-- Format & Codec -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Formato / Codec" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.CurrentData.Technical.FormatSummary, Mode=OneWay}"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       TextAlignment="Right" />
                        </Grid>

                        <!-- Bitrate -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Taxa de Bits" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.CurrentData.Technical.BitrateFormatted, Mode=OneWay}"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       TextAlignment="Right" />
                        </Grid>

                        <!-- Sample Rate -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Taxa de Amostragem" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.CurrentData.Technical.SampleRateFormatted, Mode=OneWay}"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       TextAlignment="Right" />
                        </Grid>

                        <!-- Bit Depth -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Profundidade" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.CurrentData.Technical.BitDepthFormatted, Mode=OneWay}"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       TextAlignment="Right" />
                        </Grid>

                        <!-- Channels -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Canais" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.CurrentData.Technical.ChannelsDescription, Mode=OneWay}"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       TextAlignment="Right" />
                        </Grid>

                        <!-- Duration -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Duração" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.CurrentData.Technical.DurationFormatted, Mode=OneWay}"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       TextAlignment="Right" />
                        </Grid>

                        <!-- File Size -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Tamanho em Disco" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.CurrentData.Technical.FileSizeFormatted, Mode=OneWay}"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       TextAlignment="Right" />
                        </Grid>

                        <!-- Physical File Path with Copy Button -->
                        <StackPanel Spacing="4" Margin="0,4,0,0">
                            <Grid>
                                <TextBlock Text="Caminho do Arquivo" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <Button HorizontalAlignment="Right"
                                        Padding="4,2"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        Command="{x:Bind ViewModel.CopyToClipboardCommand}"
                                        CommandParameter="{x:Bind ViewModel.CurrentData.Technical.FilePath, Mode=OneWay}"
                                        ToolTipService.ToolTip="Copiar caminho completo">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                                </Button>
                            </Grid>
                            <TextBlock Text="{x:Bind ViewModel.CurrentData.Technical.FilePath, Mode=OneWay}"
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       IsTextSelectionEnabled="True" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Tags & Editorial Metadata Card (Phase 4) -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8EC;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Metadados &amp; Tags"
                                       FontWeight="SemiBold"
                                       FontSize="13" />
                        </StackPanel>

                        <MenuFlyoutSeparator Margin="-14,0,-14,0" />

                        <!-- Track and Disc Number -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Faixa / Disco" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.CurrentData.Tags.TrackAndDiscSummary, Mode=OneWay}"
                                       FontSize="12"
                                       TextAlignment="Right" />
                        </Grid>

                        <!-- Year -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Ano" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.CurrentData.Tags.YearSummary, Mode=OneWay}"
                                       FontSize="12"
                                       TextAlignment="Right" />
                        </Grid>

                        <!-- Genres -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Gênero(s)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.CurrentData.Tags.GenresFormatted, Mode=OneWay}"
                                       FontSize="12"
                                       TextAlignment="Right"
                                       TextWrapping="Wrap" />
                        </Grid>

                        <!-- Composer -->
                        <Grid Visibility="{x:Bind ViewModel.CurrentData.Tags.Composer, Mode=OneWay, Converter={StaticResource NullOrEmptyStringToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Compositor" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.CurrentData.Tags.Composer, Mode=OneWay}"
                                       FontSize="12"
                                       TextAlignment="Right"
                                       TextWrapping="Wrap" />
                        </Grid>

                        <!-- ReplayGain Expander / Card -->
                        <Expander Header="ReplayGain"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch"
                                  Padding="8,4"
                                  Margin="0,4,0,0">
                            <StackPanel Spacing="6" Padding="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Ganho da Faixa" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind ViewModel.CurrentData.Tags.ReplayGainTrackGainFormatted, Mode=OneWay}"
                                               FontSize="11" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Pico da Faixa" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind ViewModel.CurrentData.Tags.ReplayGainTrackPeakFormatted, Mode=OneWay}"
                                               FontSize="11" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Ganho do Álbum" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind ViewModel.CurrentData.Tags.ReplayGainAlbumGainFormatted, Mode=OneWay}"
                                               FontSize="11" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Pico do Álbum" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind ViewModel.CurrentData.Tags.ReplayGainAlbumPeakFormatted, Mode=OneWay}"
                                               FontSize="11" />
                                </Grid>
                            </StackPanel>
                        </Expander>

                        <!-- Lyrics Expander -->
                        <Expander Header="Letras Locais"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch"
                                  Padding="8,4"
                                  Visibility="{x:Bind ViewModel.CurrentData.Tags.HasLyrics, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{x:Bind ViewModel.CurrentData.Tags.LyricsPreview, Mode=OneWay}"
                                       FontSize="11"
                                       FontStyle="Italic"
                                       TextWrapping="Wrap"
                                       Padding="4" />
                        </Expander>
                    </StackPanel>
                </Border>

                <!-- Fingerprint & Acoustic Recognition Card (Feature 004) -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14">
                    <StackPanel Spacing="12">
                        <!-- Card Header -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE95B;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="Reconhecimento Acústico"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Status Badge -->
                            <Border Grid.Column="1"
                                    Visibility="{x:Bind ViewModel.IsAlreadyIdentified, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="4"
                                    Padding="8,2">
                                <TextBlock Text="Já Identificada"
                                           FontSize="11"
                                           FontWeight="Medium"
                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            </Border>
                            <Border Grid.Column="1"
                                    Visibility="{x:Bind ViewModel.IsAlreadyIdentified, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="4"
                                    Padding="8,2">
                                <TextBlock Text="Não Identificada"
                                           FontSize="11"
                                           FontWeight="Medium"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </Grid>

                        <MenuFlyoutSeparator Margin="-14,0,-14,0" />

                        <!-- Fingerprint Hash display (if available) -->
                        <Grid Visibility="{x:Bind ViewModel.FingerprintHash, Mode=OneWay, Converter={StaticResource NullOrEmptyStringToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Chromaprint"
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.FingerprintHash, Mode=OneWay}"
                                       FontSize="10"
                                       FontFamily="Consolas, Cascadia Code, Courier New"
                                       TextTrimming="CharacterEllipsis"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"
                                       Margin="4,0" />
                            <Button Grid.Column="2"
                                    Padding="4,2"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    Command="{x:Bind ViewModel.CopyToClipboardCommand}"
                                    CommandParameter="{x:Bind ViewModel.FingerprintHash, Mode=OneWay}"
                                    ToolTipService.ToolTip="Copiar Hash Chromaprint">
                                <FontIcon Glyph="&#xE8C8;" FontSize="10" />
                            </Button>
                        </Grid>

                        <!-- Action Buttons -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button HorizontalAlignment="Stretch"
                                    Command="{x:Bind ViewModel.IdentifyTrackCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsRecognizing, Mode=OneWay, Converter={StaticResource BooleanToInverseBooleanConverter}}"
                                    Style="{ThemeResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE95B;" FontSize="12" />
                                    <TextBlock Text="Identificar via Áudio" FontSize="12" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="1"
                                    Margin="6,0,0,0"
                                    Command="{x:Bind ViewModel.ReidentifyTrackCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsRecognizing, Mode=OneWay, Converter={StaticResource BooleanToInverseBooleanConverter}}"
                                    Visibility="{x:Bind ViewModel.IsAlreadyIdentified, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ToolTipService.ToolTip="Recalcular impressão e reidentificar">
                                <FontIcon Glyph="&#xE72C;" FontSize="12" />
                            </Button>
                        </Grid>

                        <!-- Indeterminate Progress Bar during recognition -->
                        <StackPanel Spacing="6"
                                    Visibility="{x:Bind ViewModel.IsRecognizing, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ProgressBar IsIndeterminate="True" HorizontalAlignment="Stretch" />
                            <TextBlock Text="{x:Bind ViewModel.RecognitionStatusText, Mode=OneWay}"
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Status text when NOT recognizing -->
                        <TextBlock Text="{x:Bind ViewModel.RecognitionStatusText, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.IsRecognizing, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />

                        <!-- Recognition Candidates Section -->
                        <StackPanel Spacing="8"
                                    Visibility="{x:Bind ViewModel.RecognitionCandidates, Mode=OneWay, Converter={StaticResource CollectionToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Candidatos Encontrados"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Padding="6,2"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        Command="{x:Bind ViewModel.DiscardCandidatesCommand}"
                                        ToolTipService.ToolTip="Descartar candidatos">
                                    <TextBlock Text="Descartar" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Button>
                            </Grid>

                            <ItemsControl ItemsSource="{x:Bind ViewModel.RecognitionCandidates, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:RecognitionCandidate">
                                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="10"
                                                Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- Title & Confidence Badge -->
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="{x:Bind Title}"
                                                               FontWeight="SemiBold"
                                                               FontSize="12"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />

                                                    <!-- High confidence badge (>= 80%) -->
                                                    <Border Grid.Column="1"
                                                            Visibility="{x:Bind IsHighConfidence, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                            Background="#7C4DFF"
                                                            CornerRadius="4"
                                                            Padding="6,1"
                                                            Margin="4,0,0,0">
                                                        <TextBlock Text="{x:Bind ConfidenceDisplay}"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"
                                                                   Foreground="White" />
                                                    </Border>

                                                    <!-- Regular confidence badge (< 80%) -->
                                                    <Border Grid.Column="1"
                                                            Visibility="{x:Bind IsHighConfidence, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                                            Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                                            CornerRadius="4"
                                                            Padding="6,1"
                                                            Margin="4,0,0,0">
                                                        <TextBlock Text="{x:Bind ConfidenceDisplay}"
                                                                   FontSize="10"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </Border>
                                                </Grid>

                                                <!-- Artist & Album -->
                                                <StackPanel Grid.Row="1" Spacing="2" Margin="0,4,0,6">
                                                    <TextBlock Text="{x:Bind Artist}"
                                                               FontSize="11"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind Album}"
                                                               FontSize="10"
                                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Visibility="{x:Bind Album, Converter={StaticResource NullOrEmptyStringToVisibilityConverter}}" />
                                                </StackPanel>

                                                <!-- Link Action Button -->
                                                <Button Grid.Row="2"
                                                        HorizontalAlignment="Right"
                                                        Padding="10,4"
                                                        Command="{Binding DataContext.SelectCandidateCommand, ElementName=InspectorRoot}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <FontIcon Glyph="&#xE71B;" FontSize="10" />
                                                        <TextBlock Text="Vincular à Faixa" FontSize="11" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Identifiers & Provenance Card (Phase 5) -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8B9;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Proveniência &amp; Identificadores"
                                       FontWeight="SemiBold"
                                       FontSize="13" />
                        </StackPanel>

                        <MenuFlyoutSeparator Margin="-14,0,-14,0" />

                        <!-- Provenance Badge -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Origem" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Border Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="4"
                                    Padding="8,2">
                                <TextBlock Text="{x:Bind ViewModel.CurrentData.ProvenanceLabel, Mode=OneWay}"
                                           FontSize="11"
                                           FontWeight="Medium"
                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            </Border>
                        </Grid>

                        <!-- ISRC -->
                        <Grid Visibility="{x:Bind ViewModel.CurrentData.Tags.Isrc, Mode=OneWay, Converter={StaticResource NullOrEmptyStringToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ISRC" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.CurrentData.Tags.Isrc, Mode=OneWay}"
                                       FontSize="11"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="2"
                                    Padding="4,2"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    Command="{x:Bind ViewModel.CopyToClipboardCommand}"
                                    CommandParameter="{x:Bind ViewModel.CurrentData.Tags.Isrc, Mode=OneWay}"
                                    ToolTipService.ToolTip="Copiar ISRC">
                                <FontIcon Glyph="&#xE8C8;" FontSize="10" />
                            </Button>
                        </Grid>

                        <!-- MusicBrainz Track ID -->
                        <Grid Visibility="{x:Bind ViewModel.CurrentData.ExternalIds.MusicBrainzTrackId, Mode=OneWay, Converter={StaticResource NullOrEmptyStringToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="MB Track ID" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.CurrentData.ExternalIds.MusicBrainzTrackId, Mode=OneWay}"
                                       FontSize="10"
                                       TextTrimming="CharacterEllipsis"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="2"
                                    Padding="4,2"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    Command="{x:Bind ViewModel.CopyToClipboardCommand}"
                                    CommandParameter="{x:Bind ViewModel.CurrentData.ExternalIds.MusicBrainzTrackId, Mode=OneWay}"
                                    ToolTipService.ToolTip="Copiar MusicBrainz Track ID">
                                <FontIcon Glyph="&#xE8C8;" FontSize="10" />
                            </Button>
                        </Grid>

                        <!-- MusicBrainz Release ID -->
                        <Grid Visibility="{x:Bind ViewModel.CurrentData.ExternalIds.MusicBrainzReleaseId, Mode=OneWay, Converter={StaticResource NullOrEmptyStringToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="MB Release" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.CurrentData.ExternalIds.MusicBrainzReleaseId, Mode=OneWay}"
                                       FontSize="10"
                                       TextTrimming="CharacterEllipsis"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="2"
                                    Padding="4,2"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    Command="{x:Bind ViewModel.CopyToClipboardCommand}"
                                    CommandParameter="{x:Bind ViewModel.CurrentData.ExternalIds.MusicBrainzReleaseId, Mode=OneWay}"
                                    ToolTipService.ToolTip="Copiar MusicBrainz Release ID">
                                <FontIcon Glyph="&#xE8C8;" FontSize="10" />
                            </Button>
                        </Grid>

                        <!-- AcoustID -->
                        <Grid Visibility="{x:Bind ViewModel.CurrentData.ExternalIds.AcoustId, Mode=OneWay, Converter={StaticResource NullOrEmptyStringToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="AcoustID" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.CurrentData.ExternalIds.AcoustId, Mode=OneWay}"
                                       FontSize="10"
                                       TextTrimming="CharacterEllipsis"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="2"
                                    Padding="4,2"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    Command="{x:Bind ViewModel.CopyToClipboardCommand}"
                                    CommandParameter="{x:Bind ViewModel.CurrentData.ExternalIds.AcoustId, Mode=OneWay}"
                                    ToolTipService.ToolTip="Copiar AcoustID">
                                <FontIcon Glyph="&#xE8C8;" FontSize="10" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Online Metadata Enrichment Card (Feature 005) -->
                <Expander Header="Enriquecimento de Metadados Online"
                          IsExpanded="True"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch">
                    <Expander.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE753;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="Enriquecimento de Metadados Online" FontWeight="SemiBold" FontSize="13" />
                            </StackPanel>
                        </DataTemplate>
                    </Expander.HeaderTemplate>

                    <StackPanel Spacing="12" Padding="0,8,0,0">
                        <!-- Search Trigger & Clear Buttons -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    HorizontalAlignment="Stretch"
                                    Command="{x:Bind ViewModel.FetchMetadataCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsEnriching, Mode=OneWay, Converter={StaticResource BooleanToInverseBooleanConverter}}"
                                    Style="{ThemeResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <ProgressRing IsActive="{x:Bind ViewModel.IsEnriching, Mode=OneWay}"
                                                  Width="16" Height="16"
                                                  Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                  Visibility="{x:Bind ViewModel.IsEnriching, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <FontIcon Glyph="&#xE721;" FontSize="12"
                                              Visibility="{x:Bind ViewModel.IsEnriching, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                    <TextBlock Text="{x:Bind ViewModel.EnrichmentButtonText, Mode=OneWay}" FontSize="12" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Command="{x:Bind ViewModel.ClearProposalCommand}"
                                    Visibility="{x:Bind ViewModel.HasEnrichmentProposal, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ToolTipService.ToolTip="Limpar proposta">
                                <FontIcon Glyph="&#xE711;" FontSize="11" />
                            </Button>
                        </Grid>

                        <!-- Status text feedback -->
                        <TextBlock Text="{x:Bind ViewModel.EnrichmentStatusText, Mode=OneWay}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="{x:Bind ViewModel.EnrichmentStatusText, Mode=OneWay, Converter={StaticResource NullOrEmptyStringToVisibilityConverter}}" />

                        <!-- Proposal Details (Shown when a proposal has been generated) -->
                        <StackPanel Spacing="12"
                                    Visibility="{x:Bind ViewModel.HasEnrichmentProposal, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">

                            <!-- Side-by-side Cover Art Preview -->
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10"
                                    Visibility="{x:Bind ViewModel.CurrentProposal.ProposedCoverUrl, Mode=OneWay, Converter={StaticResource NullOrEmptyStringToVisibilityConverter}}">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xEB9F;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="Capa Oficial (Cover Art Archive)" FontSize="11" FontWeight="SemiBold" />
                                    </StackPanel>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Local Cover -->
                                        <StackPanel Grid.Column="0" Spacing="4" HorizontalAlignment="Center">
                                            <TextBlock Text="Capa Local" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                            <Border Width="88" Height="88" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                <Image Source="{x:Bind ViewModel.CurrentData.Artwork.CoverArtUri, Mode=OneWay}"
                                                       Stretch="UniformToFill" />
                                            </Border>
                                        </StackPanel>

                                        <!-- Proposed CAA Cover -->
                                        <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Center">
                                            <TextBlock Text="Sugerida (CAA 500px)" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                            <Border Width="88" Height="88" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                <Image Source="{x:Bind ViewModel.CurrentProposal.ProposedCoverUrl, Mode=OneWay}"
                                                       Stretch="UniformToFill" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Field-by-field Proposals List -->
                            <TextBlock Text="Campos Sugeridos" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" />

                            <ItemsControl ItemsSource="{x:Bind ViewModel.CurrentProposal.Proposals, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:FieldProposal">
                                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="8"
                                                Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Selection Checkbox (TwoWay per FR-012) -->
                                                <CheckBox Grid.Column="0"
                                                          IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                          MinWidth="28"
                                                          Margin="0,0,4,0"
                                                          VerticalAlignment="Center" />

                                                <!-- Field Name & Values -->
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind FieldName}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold" />

                                                    <!-- Proposed Value -->
                                                    <TextBlock Text="{x:Bind ProposedValue}"
                                                               FontSize="11"
                                                               FontWeight="Medium"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                                                    <!-- Current (Local) Value -->
                                                    <TextBlock FontSize="10"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                                                        <Run Text="Local: " />
                                                        <Run Text="{x:Bind CurrentValue}" />
                                                    </TextBlock>
                                                </StackPanel>

                                                <!-- Status & Provenance Badges -->
                                                <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <!-- NewValue Badge (Green) -->
                                                    <Border Visibility="{x:Bind IsNewValue, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                            Background="#2E7D32"
                                                            CornerRadius="4"
                                                            Padding="6,1">
                                                        <TextBlock Text="Novo" FontSize="10" FontWeight="Bold" Foreground="White" />
                                                    </Border>

                                                    <!-- Updated Badge (Amber) -->
                                                    <Border Visibility="{x:Bind IsUpdated, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                            Background="#F57F17"
                                                            CornerRadius="4"
                                                            Padding="6,1">
                                                        <TextBlock Text="Atualizado" FontSize="10" FontWeight="Bold" Foreground="White" />
                                                    </Border>

                                                    <!-- Conflict Badge (Red) -->
                                                    <Border Visibility="{x:Bind IsConflict, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                            Background="#D32F2F"
                                                            CornerRadius="4"
                                                            Padding="6,1">
                                                        <TextBlock Text="Conflito" FontSize="10" FontWeight="Bold" Foreground="White" />
                                                    </Border>

                                                    <!-- Unchanged Badge (Subtle) -->
                                                    <Border Visibility="{x:Bind IsUnchanged, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                            Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                                            CornerRadius="4"
                                                            Padding="6,1">
                                                        <TextBlock Text="Inalterado" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </Border>

                                                    <!-- Provenance Label -->
                                                    <TextBlock Text="{x:Bind ProvenanceDisplay}"
                                                               FontSize="9"
                                                               HorizontalAlignment="Right"
                                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Advance Button (Safe transition, zero bytes written per Princípio VII) -->
                            <Button HorizontalAlignment="Stretch"
                                    Command="{x:Bind ViewModel.AdvanceToTagReviewCommand}"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Margin="0,4,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE70F;" FontSize="12" />
                                    <TextBlock Text="Avançar para Revisão de Tags" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Expander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
