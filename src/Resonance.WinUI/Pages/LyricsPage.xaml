<Page
    x:Class="Resonance.WinUI.Pages.LyricsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:core="using:Resonance.Core.Models.Lyrics"
    xmlns:resources="using:Resonance.WinUI.Resources"
    xmlns:helpers="using:Resonance.WinUI.Helpers"
    mc:Ignorable="d"
    Background="Transparent"
    Loaded="OnPageLoaded">


    <Page.Resources>
        <ResourceDictionary>
            <!-- IMPORTANT: This Storyboard is triggered in code-behind (LyricsPage.xaml.cs, OnPageLoaded) and must NOT be removed by cleanup tools. -->
            <Storyboard x:Key="PageLoadStoryboard">
                <DoubleAnimation
                    Storyboard.TargetName="LyricsContainer"
                    Storyboard.TargetProperty="Opacity"
                    From="0" To="1" Duration="0:0:0.5">
                    <DoubleAnimation.EasingFunction>
                        <ExponentialEase EasingMode="EaseOut" Exponent="3"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="LyricsContainer" Opacity="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            Margin="24,32,24,8">
            <StackPanel
                HorizontalAlignment="Center"
                Spacing="6">
                <TextBlock
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.SongTitle, Mode=OneWay}"
                    Foreground="{StaticResource AppPrimaryColorBrush}"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap"
                    MaxLines="1"
                    MaxWidth="1000" />
                <!-- Provenance & Status Badges -->
                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.HasProvenanceLabel, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8,2">
                        <TextBlock
                            Text="{x:Bind ViewModel.ProvenanceLabel, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Border>
                    <Border
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="4"
                        Padding="8,2"
                        Visibility="{x:Bind ViewModel.IsPlain, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock
                            Text="Não Sincronizada"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- Actions (Top Right) -->
            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Spacing="8">
                <Button
                    x:Name="ExportLrcButton"
                    Style="{StaticResource SubtleButtonStyle}"
                    Command="{x:Bind ViewModel.ExportSidecarLrcCommand}"
                    Visibility="{x:Bind ViewModel.CanExportLrc, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                    AutomationProperties.Name="Exportar como .lrc"
                    ToolTipService.ToolTip="Exportar como .lrc">
                    <FontIcon Glyph="&#xEDE1;" />
                </Button>
                <Button
                    x:Name="EditLyricsButton"
                    Style="{StaticResource SubtleButtonStyle}"
                    IsEnabled="{x:Bind ViewModel.CanEditLyrics, Mode=OneWay}"
                    Click="EditLyricsButton_Click"
                    AutomationProperties.Name="{x:Bind resources:Strings.LyricsPage_EditLyrics_ToolTip, Mode=OneTime}"
                    ToolTipService.ToolTip="{x:Bind resources:Strings.LyricsPage_EditLyrics_ToolTip, Mode=OneTime}">
                    <FontIcon Glyph="&#xE70F;" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Progress bar and Offset calibration controls -->
        <StackPanel
            Grid.Row="1"
            Margin="24,8,24,12"
            Spacing="8"
            Visibility="{x:Bind ViewModel.ShowTimedLyrics, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ProgressBar
                x:Name="LyricsProgressBar"
                Style="{StaticResource LyricsProgressBarStyle}"
                HorizontalAlignment="Center"
                Width="500" />

            <!-- Offset calibration toolbar -->
            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="6">
                <Button
                    Content="-500ms"
                    Style="{StaticResource SubtleButtonStyle}"
                    Padding="6,2"
                    FontSize="11"
                    Command="{x:Bind ViewModel.AdjustOffsetCommand}"
                    CommandParameter="-500"
                    ToolTipService.ToolTip="Atrasar letras em 500 ms" />
                <Button
                    Content="-100ms"
                    Style="{StaticResource SubtleButtonStyle}"
                    Padding="6,2"
                    FontSize="11"
                    Command="{x:Bind ViewModel.AdjustOffsetCommand}"
                    CommandParameter="-100"
                    ToolTipService.ToolTip="Atrasar letras em 100 ms" />
                <TextBlock
                    Text="{x:Bind ViewModel.FormattedOffset, Mode=OneWay}"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Margin="4,0" />
                <Button
                    Content="+100ms"
                    Style="{StaticResource SubtleButtonStyle}"
                    Padding="6,2"
                    FontSize="11"
                    Command="{x:Bind ViewModel.AdjustOffsetCommand}"
                    CommandParameter="100"
                    ToolTipService.ToolTip="Adiantar letras em 100 ms" />
                <Button
                    Content="+500ms"
                    Style="{StaticResource SubtleButtonStyle}"
                    Padding="6,2"
                    FontSize="11"
                    Command="{x:Bind ViewModel.AdjustOffsetCommand}"
                    CommandParameter="500"
                    ToolTipService.ToolTip="Adiantar letras em 500 ms" />
                <Button
                    Content="Zerar"
                    Style="{StaticResource SubtleButtonStyle}"
                    Padding="6,2"
                    FontSize="11"
                    Command="{x:Bind ViewModel.ResetOffsetCommand}"
                    ToolTipService.ToolTip="Redefinir offset para 0 ms" />
            </StackPanel>
        </StackPanel>

        <!-- Synchronized (timed) lyrics display -->
        <ScrollViewer
            x:Name="LyricsScrollViewer"
            Grid.Row="2"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            Background="Transparent"
            SizeChanged="LyricsScrollViewer_SizeChanged"
            Visibility="{x:Bind ViewModel.ShowTimedLyrics, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <Border x:Name="TopSpacer" />
                <ItemsRepeater
                    x:Name="LyricsRepeater"
                    ItemsSource="{x:Bind ViewModel.LyricLines, Mode=OneWay}"
                    ElementPrepared="LyricsRepeater_ElementPrepared"
                    ElementClearing="LyricsRepeater_ElementClearing">
                    <ItemsRepeater.Layout>
                        <helpers:NonVirtualizingStackLayout />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="core:LyricLine">
                            <Grid
                                Padding="32,28"
                                Background="Transparent"
                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                Tag="{x:Bind}"
                                PointerEntered="LyricItem_PointerEntered"
                                PointerExited="LyricItem_PointerExited"
                                Tapped="LyricItem_Tapped">
                                <!-- Base (inactive) text -->
                                <StackPanel Spacing="6">
                                    <TextBlock
                                        Text="{x:Bind Text}"
                                        Style="{StaticResource LyricLineTextBlockStyle}" />
                                    <TextBlock
                                        Text="{x:Bind RomanizedText}"
                                        Style="{StaticResource RomanizedLyricLineTextBlockStyle}"
                                        Visibility="{x:Bind HasRomanizedText, Mode=OneTime, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                                <!-- Active color overlay (opacity controlled entirely via Composition) -->
                                <StackPanel Spacing="6">
                                    <TextBlock
                                        Text="{x:Bind Text}"
                                        Style="{StaticResource LyricLineTextBlockStyle}"
                                        Foreground="{StaticResource AppPrimaryColorBrush}" />
                                    <TextBlock
                                        Text="{x:Bind RomanizedText}"
                                        Style="{StaticResource RomanizedLyricLineTextBlockStyle}"
                                        Foreground="{StaticResource AppPrimaryColorBrush}"
                                        Visibility="{x:Bind HasRomanizedText, Mode=OneTime, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <Border x:Name="BottomSpacer" />
            </StackPanel>
        </ScrollViewer>

        <!-- Unsynchronized (plain text) lyrics display -->
        <ListView
            Grid.Row="2"
            Padding="24,0,24,132"
            ItemsSource="{x:Bind ViewModel.UnsyncedLyricLines, Mode=OneWay}"
            Background="Transparent"
            SelectionMode="None"
            IsItemClickEnabled="False"
            HorizontalContentAlignment="Stretch"
            ItemContainerStyle="{StaticResource LyricsListViewItemStyle}"
            Visibility="{x:Bind ViewModel.HasUnsyncedLyrics, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ListView.Header>
                <Border
                    HorizontalAlignment="Center"
                    Margin="0,8,0,16"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="4"
                    Padding="12,4">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8D2;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock
                            Text="Letras não sincronizadas"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="core:LyricLine">
                    <StackPanel>
                        <TextBlock
                            Text="{x:Bind Text}"
                            Style="{StaticResource InactiveLyricLineStyle}"
                            Opacity="1.0" />
                        <TextBlock
                            Text="{x:Bind RomanizedText}"
                            Style="{StaticResource RomanizedInactiveLyricLineStyle}"
                            Visibility="{x:Bind HasRomanizedText, Mode=OneTime, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Instrumental message -->
        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16"
            Visibility="{x:Bind ViewModel.IsInstrumental, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="20" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>
            <FontIcon
                Glyph="&#xEC4F;"
                FontSize="48"
                Margin="0,0,0,12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalAlignment="Center" />
            <TextBlock
                Style="{StaticResource TitleTextBlockStyle}"
                Text="♫ Faixa Instrumental"
                HorizontalAlignment="Center" />
            <TextBlock
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Esta faixa foi identificada como instrumental."
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </StackPanel>

        <!-- No lyrics message -->
        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16"
            Visibility="{x:Bind ViewModel.ShowNoLyricsMessage, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="20" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>
            <FontIcon
                Glyph="&#xED1E;"
                FontSize="48"
                Margin="0,0,0,12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalAlignment="Center" />
            <TextBlock
                Style="{StaticResource TitleTextBlockStyle}"
                Text="{x:Bind resources:Strings.LyricsPage_NoLyrics_Title, Mode=OneTime}"
                HorizontalAlignment="Center" />
            <TextBlock
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="{x:Bind resources:Strings.LyricsPage_NoLyrics_Subtitle, Mode=OneTime}"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </StackPanel>

        <ProgressRing
            Grid.Row="2"
            Width="48"
            Height="48"
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />
    </Grid>
</Page>
